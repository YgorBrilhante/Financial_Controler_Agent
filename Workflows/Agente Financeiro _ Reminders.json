      "name": "Insere Lembrete"
    },
    {
      "parameters": {
        "jsCode": "// Function node (n8n) — Corrige reminder_date para fuso horário de São Paulo (UTC-3)\n\n// Importa objeto de entrada (do agente)\nconst item = items[0].json;\n\n// Data retornada pelo agente (exemplo: \"2025-10-27T18:00:00Z\")\nconst agentDate = $input.first().json.output.reminder_date;\n\n// Fuso fixo (São Paulo)\nconst timezoneOffset = -3; // UTC-3 (sem horário de verão)\n\n// Função auxiliar\nfunction convertToSaoPaulo(dateStr) {\n  if (!dateStr) return null;\n\n  // Converte a data de entrada para um objeto Date\n  const dateObj = new Date(dateStr);\n\n  if (isNaN(dateObj.getTime())) {\n    throw new Error(`Data inválida: ${dateStr}`);\n  }\n\n  // Ajusta o horário subtraindo o offset (3 horas)\n  const localMillis = dateObj.getTime() + timezoneOffset * 60 * 60 * 1000;\n\n  // Cria nova data corrigida\n  const localDate = new Date(localMillis);\n\n  // Retorna em formato ISO sem 'Z' (representa horário local)\n  const isoLocal = localDate.toISOString().replace('Z', '');\n\n  return isoLocal;\n}\n\nlet correctedDate;\n\ntry {\n  correctedDate = convertToSaoPaulo(agentDate);\n} catch (err) {\n  correctedDate = null;\n  console.error('Erro ao converter data:', err.message);\n}\n\n// Monta o JSON final para saída\nreturn [\n  {\n    json: {\n      //...item,\n      reminder_date: correctedDate, // já corrigido para horário de São Paulo\n      //reminder_date_original: agentDate // opcional, para referência\n    }\n  }\n];\n"
      },
