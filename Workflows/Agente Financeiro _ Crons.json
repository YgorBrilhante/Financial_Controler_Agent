    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO transactions (user_id, category_id, recurring_transaction_id, amount, type, description, transaction_date, auto_generated)\nSELECT \n  user_id, category_id, id, amount, type, description, next_due_date, TRUE\nFROM recurring_transactions\nWHERE next_due_date <= CURRENT_DATE\n  AND (end_date IS NULL OR end_date >= CURRENT_DATE);",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        16,
        528
      ],
      "id": "103f789f-0f25-4b56-9818-7508bdf9affd",
      "name": "Insere transaction"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE recurring_transactions\nSET last_generated = CURRENT_DATE,\n    next_due_date = \n      CASE \n        WHEN frequency = 'weekly' THEN next_due_date + INTERVAL '7 days'\n        WHEN frequency = 'monthly' THEN next_due_date + INTERVAL '1 month'\n        WHEN frequency = 'yearly' THEN next_due_date + INTERVAL '1 year'\n      END\nWHERE next_due_date <= CURRENT_DATE;\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        528
      ],
      "id": "0e09499c-db5b-4af8-9d9c-8b18edc8006b",
